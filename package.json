{
  "name": "dsh-deepseek-tools",
  "version": "0.1.0",
  "description": "把 DeepSeek 工具 API（网页搜索、网页抓取、OCR、语音合成、语音识别）注册成 DSH 里模型可调用的工具。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "tools-api",
    "search",
    "fetch",
    "ocr",
    "tts",
    "asr"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
